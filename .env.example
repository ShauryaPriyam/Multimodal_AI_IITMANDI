# Copy this file to .env and fill in values. Do not commit .env.

# Optional Copernicus Data Space Ecosystem credentials.
# Searching public Sentinel and Copernicus DEM collections does not need a key.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=

# Preferred pre-event OpenStreetMap snapshot for the ohsome API.
# The pipeline must query a day strictly before the flood date.
# 2026-07-27 is the audited snapshot for floods after that day.
OSM_SNAPSHOT_DATE=2026-07-27

# Segmentation checkpoint trained on Kuro Siwo or Sen1Floods11.
MODEL_WEIGHTS=weights/flood_model.pt

# Single CARTO basemap key from https://carto.com/basemaps/apikey/
# The viewer adds it to dashboard tile URLs as ?key=
CARTO_BASEMAP_KEY=
